# Copy to .env (git-ignored) and fill in. GEMINI_API_KEY enables the standard
# semantic audit via Google's Gemini Decisions API.
GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted for compatibility.
# Optional: raises the PageSpeed Insights rate limit (free key from Google Cloud).
PAGESPEED_API_KEY=
# Optional: only for --full mode (paid per call).
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=
